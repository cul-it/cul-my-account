-if @available_requests.length == 0
  %p.no-results
    You have no requests ready for pickup.
-else
  = form_tag({controller: :account, action: :index}, :id => 'available-requests-form') do
    %div.table-responsive
      %table#available-requests-table.table.table-striped.tablesort
        %thead
          %tr
            %th{:scope => 'col', :class => 'myacct-col-50 sortable', 'aria-sort' => 'none', :tabindex => '0'} Title
            %th{:scope => 'col', :class => 'myacct-col-20 sortable', 'aria-sort' => 'none', :tabindex => '0'} Author
            %th{:scope => 'col', :class => 'myacct-col-20 sortable', 'aria-sort' => 'none', :tabindex => '0'} Pick up at
        %tbody
          - @available_requests.each do |c|
            %tr.item{:id => "#{c['iid']}"} 
              %td{
                data: (Rails.env.development? ? { blur_target: true } : {}),
                class: (Rails.env.development? && ENV['DEBUG_PRIVACY'] == 'true' ? 'blurred' : nil)
              }
                = c['ou_title'] || c['tl']
              %td{
                data: (Rails.env.development? ? { blur_target: true } : {}),
                class: (Rails.env.development? && ENV['DEBUG_PRIVACY'] == 'true' ? 'blurred' : nil)
              }
                = c['ou_aulast'] || c['au']
              -# NOTE: The location cell will be populated by an AJAX call to get the service point name.
              -# See app/assets/javascripts/my_account/account.js.coffee
              %td.location
                = c['lo']
